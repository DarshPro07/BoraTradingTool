# MarketPulse OS — environment
# Copy to .env.local and fill in what you need. Every value below is optional:
# the app runs with none of them set, and reports AUTH_REQUIRED rather than faking data.

# Deterministic, credential-free fixtures for development and browser tests.
# When enabled, MARKETPULSE_DB_PATH must point to an explicit disposable database.
MARKETPULSE_TEST_MODE=0

# --- Market data -------------------------------------------------------------
# Yahoo is used by default and needs no key. Finnhub is optional and adds
# fundamentals, insider activity and analyst ratings. https://finnhub.io
FINNHUB_API_KEY=

# --- Quant core (Python, E:\Trading_BOT) --------------------------------------
# Read-only. The bridge prefers HTTP and falls back to reading artifacts from disk,
# so the app keeps working while the Python service is down.
QUANT_CORE_ROOT=E:/Trading_BOT
# Set to "off" to skip HTTP entirely and read only from disk.
QUANT_CORE_URL=http://127.0.0.1:8787

# --- Persistence --------------------------------------------------------------
MARKETPULSE_DB_PATH=marketpulse.db

# --- Local API access ---------------------------------------------------------
# Required only for non-browser mutations (scripts, schedulers). Must be 32+ bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MARKETPULSE_AGENT_TOKEN=

# --- Optional unattended analysis ---------------------------------------------
# Interactive analysis runs through Claude Code over MCP and needs no key here.
# These are only for scheduled jobs that must run with Claude Code closed.
# Use a Console API key. A Claude Pro/Max subscription token is NOT valid here —
# Anthropic's consumer terms restrict those to Claude Code and Claude.ai.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
