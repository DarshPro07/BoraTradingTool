# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but ship the template so fresh clones can copy it
!.env.example

# Shared Claude Code control-plane assets are versioned. Machine-local state is not.
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/agents/**
!.claude/hooks/
!.claude/hooks/**
!.claude/skills/
!.claude/skills/**
.claude/settings.local.json
.claude/worktrees/

# local SQLite database — contains secrets (Telegram bot token, chat id) and
# runtime state. NEVER commit this.
marketpulse.db
marketpulse.db-shm
marketpulse.db-wal
/.tmp/
/.backups/
/dist/
/playwright-report/
/test-results/

# runtime-generated agent context files (rewritten when pages are viewed)
/context/

# local screenshot helper output
mp-*.mjs

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
