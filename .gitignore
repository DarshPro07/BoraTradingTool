# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but ship the template so fresh clones can copy it
!.env.example

# Shared Claude Code control-plane assets are versioned. Machine-local state is not.
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/agents/**
!.claude/hooks/
!.claude/hooks/**
!.claude/skills/
!.claude/skills/**
.claude/settings.local.json
.claude/worktrees/

# local SQLite database — contains secrets (Telegram bot token, chat id) and
# runtime state. NEVER commit this.
marketpulse.db
marketpulse.db-shm
marketpulse.db-wal
/.tmp/
/.backups/
/dist/
/playwright-report/
/test-results/
# Browser-verification scratch: page snapshots and console logs written on every Playwright MCP
# navigation. Useful while diagnosing, worthless afterwards, and they accumulate one file per
# page view — committing them buries real diffs under generated noise.
/.playwright-mcp/
npm-ci.log

# runtime-generated agent context files (rewritten when pages are viewed)
/context/

# quant-core artifacts generated from the local database on every learning cycle. Derived state,
# not source — committing them would freeze one machine's trial ledger into the repository.
# A hand-supplied packet dropped here is deliberately ignored too: it is that machine's evidence.
/data/quantcore/

# local screenshot helper output
mp-*.mjs

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Thread engineering scratch
threads/

# Runtime lease files: the live cycle rewrites these every few minutes, which turns any
# stash, rebase or merge into a conflict over state that is not source.
marketpulse.db.*-lease

# Scheduled-task stdout, so a crashed autonomous run leaves a diagnosis behind.
logs/
# docs/plans/cloud-clock: this machine's ledger writer switch
marketpulse.db.writer
