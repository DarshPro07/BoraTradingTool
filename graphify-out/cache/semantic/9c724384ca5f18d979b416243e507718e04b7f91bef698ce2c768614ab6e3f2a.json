{"nodes": [{"id": "tdd_skill", "label": "Test-Driven Development Skill", "file_type": "document", "source_file": ".agents/skills/tdd/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Red-green-refactor with vertical tracer-bullet slices; tests verify behavior through public interfaces only."}, {"id": "tdd_behavior_principle", "label": "Behavior-Over-Implementation Principle", "file_type": "document", "source_file": ".agents/skills/tdd/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Core principle: code can change entirely, tests shouldn't; tests describe WHAT not HOW; they survive refactors."}, {"id": "tdd_red_green_refactor", "label": "Red-Green-Refactor Loop", "file_type": "document", "source_file": ".agents/skills/tdd/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One test at a time; only enough code to pass; never refactor while RED."}, {"id": "tdd_tracer_bullet", "label": "Tracer Bullet Vertical Slices", "file_type": "document", "source_file": ".agents/skills/tdd/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One test then one implementation, repeated; each test responds to what the previous cycle learned."}, {"id": "tdd_horizontal_slices_antipattern", "label": "Horizontal Slices Anti-Pattern", "file_type": "rationale", "source_file": ".agents/skills/tdd/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All tests first then all implementation produces crap tests of imagined behavior; tests become insensitive to real changes."}, {"id": "tdd_planning_phase", "label": "TDD Planning Phase", "file_type": "document", "source_file": ".agents/skills/tdd/SKILL.md", "source_locati