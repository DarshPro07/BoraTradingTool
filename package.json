{
  "name": "marketpulse-scaffold",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && npm run build:mcp",
    "build:mcp": "node esbuild.mcp.mjs",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude mcp/**/*.test.ts",
    "test:mcp": "npm run build:mcp && vitest run mcp/server.integration.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run test:mcp && npm run build",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@base-ui/react": "^1.5.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "better-sqlite3": "^12.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.18.0",
    "next": "^16.3.0",
    "openai": "^7.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
